{
  "name": "interchampionship",
  "version": "1.0.0",
  "private": true,
  "description": "InterChampionship – PWA der UHC Flying Penguins für Spieltage, Anwesenheit, Skorer und Rangliste",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "node scripts/build.mjs && http-server dist -p 4173 -c-1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build": "node scripts/build.mjs",
    "test:e2e": "playwright test -c playwright.e2e.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "http-server": "14.1.1"
  }
}
